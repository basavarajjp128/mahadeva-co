{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "docs/**",
      "README.md",
      "package.json",
      "biome.json",
      "tsconfig.json",
      "next.config.ts",
      "postcss.config.mjs",
      "vitest.config.mts",
      "playwright.config.ts"
    ]
  }
}
