# Sanitized placeholders only. Copy to a local ignored .env file and replace locally.
# Keep only rzp_test_* API keys configured. Live credentials are rejected by this integration.
# Set true only in local development to show the test catalogue and test-only prices.
ENABLE_PAYMENT_TEST_DATA=false
RAZORPAY_KEY_ID=rzp_test_replace_with_test_key_id
RAZORPAY_KEY_SECRET=replace_with_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_test_webhook_secret

# Prisma CLI migration connection. Keep it out of the web runtime where possible.
DATABASE_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Application runtime connection for server-side payment/rate-limit operations.
# Use the dedicated smc_payment_runtime role after provisioning; never prefix with NEXT_PUBLIC_.
APP_DATABASE_URL=postgresql://smc_payment_runtime:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Exact public origin of the deployed application, without a trailing slash.
APP_ORIGIN=https://example.invalid

# Generate a random value with at least 32 characters. Used only to HMAC-hash rate-limit keys.
RATE_LIMIT_HMAC_SECRET=replace_with_random_value_at_least_32_characters
