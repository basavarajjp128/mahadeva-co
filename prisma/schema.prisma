generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentOrderStatus {
  CREATED
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentAttemptStatus {
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ProductSalesUnit {
  KG
  QUINTAL
  METRIC_TON
}

model Product {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName             String             @map("name") @db.Text
  slug                    String             @unique @db.Text
  description             String?            @db.Text
  category                String             @default("copra") @db.Text
  categoryId              String?            @map("category_id") @db.Uuid
  isActive                Boolean            @default(false) @map("is_active")
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  price                   Decimal?           @db.Decimal(14, 4)
  priceCurrency           String?            @map("price_currency") @db.Char(3)
  priceUnit               ProductSalesUnit?  @map("price_unit")
  supportedSalesUnits     ProductSalesUnit[] @default([]) @map("supported_sales_units")
  image                   String?            @map("image_path") @db.Text
  imageAlt                String?            @map("image_alt") @db.Text
  packagingInformation    String?            @map("packaging_information") @db.Text
  isSample                Boolean            @default(true) @map("is_sample")
  isDirectCheckoutEnabled Boolean            @default(false) @map("is_direct_checkout_enabled")
  updatedAt               DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  categoryRef             ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([isActive, displayName])
  @@index([categoryId])
  @@map("products")
}

model ProductCategory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.Text
  slug         String   @unique @db.Text
  parentId     String?  @map("parent_id") @db.Uuid
  description  String?  @db.Text
  imageUrl     String?  @map("image_url") @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ProductCategory[] @relation("ProductCategoryTree")
  options  CategoryOption[]
  products Product[]

  @@index([parentId])
  @@index([isActive, displayOrder])
  @@map("product_categories")
}

model QuantityUnit {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   @unique @db.Text
  symbol           String   @unique @db.Text
  unitType         String   @map("unit_type") @db.Text
  baseUnitSymbol   String?  @map("base_unit_symbol") @db.Text
  conversionToBase Decimal? @map("conversion_to_base") @db.Decimal(18, 6)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  options          CategoryOption[]

  @@map("quantity_units")
}

model PackagingType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.Text
  description String?  @db.Text
  isReusable  Boolean  @default(false) @map("is_reusable")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  options     CategoryOption[]

  @@map("packaging_types")
}

model CategoryOption {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId           String   @map("category_id") @db.Uuid
  quantityUnitId       String   @map("quantity_unit_id") @db.Uuid
  packagingTypeId      String   @map("packaging_type_id") @db.Uuid
  defaultPackSize      Decimal? @map("default_pack_size") @db.Decimal(12, 3)
  minimumOrderQuantity Decimal  @default(1) @map("minimum_order_quantity") @db.Decimal(12, 3)
  isDefault            Boolean  @default(false) @map("is_default")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  category      ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  quantityUnit  QuantityUnit    @relation(fields: [quantityUnitId], references: [id], onDelete: Restrict)
  packagingType PackagingType   @relation(fields: [packagingTypeId], references: [id], onDelete: Restrict)

  @@unique([categoryId, quantityUnitId, packagingTypeId])
  @@map("category_options")
}

model PaymentOrder {
  id                String             @id @default(uuid()) @db.Uuid
  productSlug       String             @db.VarChar(80)
  quantityKilograms Decimal            @db.Decimal(12, 3)
  unitPricePaise    Int
  amountPaise       Int
  currency          String             @db.Char(3)
  status            PaymentOrderStatus @default(CREATED)
  razorpayOrderId   String?            @unique @db.VarChar(64)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  attempts          PaymentAttempt[]

  @@index([status, createdAt])
}

model PaymentAttempt {
  id                  String               @id @default(uuid()) @db.Uuid
  orderId             String               @db.Uuid
  razorpayPaymentId   String               @unique @db.VarChar(64)
  amountPaise         Int
  amountRefundedPaise Int                  @default(0)
  currency            String               @db.Char(3)
  status              PaymentAttemptStatus
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  order               PaymentOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
}

model WebhookEvent {
  id              String   @id @default(uuid()) @db.Uuid
  providerEventId String   @unique @db.VarChar(128)
  eventType       String   @db.VarChar(80)
  bodySha256      String   @db.Char(64)
  processedAt     DateTime @default(now()) @db.Timestamptz(3)
}

model RateLimitBucket {
  id          String   @id @default(uuid()) @db.Uuid
  subjectHash String   @db.Char(64)
  windowStart DateTime @db.Timestamptz(3)
  count       Int      @default(0)

  @@unique([subjectHash, windowStart])
  @@index([windowStart])
}
